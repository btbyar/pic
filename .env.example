# =====================================================================
#  .env.example → .env болгон хуулж, "change-me" утгуудыг сольж ашиглана.
#  .env файлыг хэзээ ч git-д commit хийхгүй.
# =====================================================================

NODE_ENV=development

# ----- PostgreSQL (pgvector) -----------------------------------------
POSTGRES_USER=pic
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pic
POSTGRES_PORT=5432

# Migration, seed — schema эзэмшигч
DATABASE_URL=postgresql://pic:change-me-postgres@localhost:5432/pic

# API / worker runtime — pic_app_role (public + biometric)
PIC_APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgresql://pic_app:change-me-app@localhost:5432/pic

# Админ модуль — pic_admin_role (зөвхөн public, biometric-д эрхгүй)
PIC_ADMIN_DB_PASSWORD=change-me-admin
ADMIN_DATABASE_URL=postgresql://pic_admin:change-me-admin@localhost:5432/pic

# ----- Redis (BullMQ, rate limit, cache) -----------------------------
REDIS_URL=redis://localhost:6379

# ----- Object storage (dev: MinIO, prod: Cloudflare R2) --------------
MINIO_ROOT_USER=pic-dev
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
# Браузерт өгөх presigned URL-ийн host (docker дотор "minio" гэдэг нэр браузерт хүрэхгүй)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pic-dev
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=pic-originals
S3_BUCKET_PUBLIC=pic-public
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/pic-public

# ----- API ------------------------------------------------------------
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# TOTP secret, банкны данс шифрлэх AES-256-GCM түлхүүр (32 byte, base64)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=change-me
# IP хаягийг hash-лах HMAC түлхүүр (түүхий IP хадгалахгүй)
IP_HASH_SECRET=change-me

# ----- ML сервис ------------------------------------------------------
ML_BASE_URL=http://localhost:8000
ML_SERVICE_TOKEN=change-me

# ----- Төлбөр ---------------------------------------------------------
# mock | qpay
PAYMENT_PROVIDER=mock
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/payments/qpay/callback

# ----- Web ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- Seed (зөвхөн dev) ----------------------------------------------
SEED_ADMIN_EMAIL=admin@pic.local
SEED_ADMIN_PASSWORD=change-me-admin-login
SEED_PHOTOGRAPHER_PASSWORD=change-me-photographer-login
