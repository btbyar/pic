# =====================================================================
#  .env.example → .env болгон хуулж, "change-me" утгуудыг сольж ашиглана.
#  .env файлыг хэзээ ч git-д commit хийхгүй.
# =====================================================================

NODE_ENV=development

# ----- PostgreSQL (pgvector) -----------------------------------------
POSTGRES_USER=pic
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pic
POSTGRES_PORT=5432

# Migration, seed — schema эзэмшигч
DATABASE_URL=postgresql://pic:change-me-postgres@localhost:5432/pic

# API / worker runtime — pic_app_role (public + biometric)
PIC_APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgresql://pic_app:change-me-app@localhost:5432/pic

# Админ модуль — pic_admin_role (зөвхөн public, biometric-д эрхгүй)
PIC_ADMIN_DB_PASSWORD=change-me-admin
ADMIN_DATABASE_URL=postgresql://pic_admin:change-me-admin@localhost:5432/pic

# ----- Redis (BullMQ, rate limit, cache) -----------------------------
REDIS_URL=redis://localhost:6379

# ----- Object storage (dev: MinIO, prod: Cloudflare R2) --------------
MINIO_ROOT_USER=pic-dev
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
# Браузерт өгөх presigned URL-ийн host (docker дотор "minio" гэдэг нэр браузерт хүрэхгүй)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pic-dev
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=pic-originals
S3_BUCKET_PUBLIC=pic-public
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/pic-public

# ----- API ------------------------------------------------------------
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# TOTP secret, банкны данс шифрлэх AES-256-GCM түлхүүр (32 byte, base64)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=change-me
# IP хаягийг hash-лах HMAC түлхүүр (түүхий IP хадгалахгүй)
IP_HASH_SECRET=change-me
# Админы 2FA заавал эсэх. Хөгжүүлэлтэд түр "false" болгож болно; production-д "false" бол API асахгүй.
ADMIN_MFA_REQUIRED=true

# ----- Worker (зураг боловсруулах) -----------------------------------
# Зэрэг боловсруулах зургийн тоо. 8 vCPU сервер дээр 6 орчим.
WORKER_CONCURRENCY=2
# Redis дахь queue түлхүүрийн угтвар (нэг Redis-ийг хэд хэдэн орчин хуваалцвал өөрчилнө)
QUEUE_PREFIX=pic

# ----- ML сервис ------------------------------------------------------
ML_BASE_URL=http://localhost:8000
# API/worker ↔ ML сервисийн дотоод токен (хоёр тал ижил). Production-д 32+ тэмдэгт заавал.
ML_SERVICE_TOKEN=change-me
# ML сервисийн uvicorn процессын тоо (нэг процесс нэг зэрэг нэг зураг). CPU цөмийн тоотой ойролцоо.
ML_WORKERS=2

# ----- Төлбөр ---------------------------------------------------------
# mock | qpay. "mock" нь зөвхөн хөгжүүлэлтэд (мөнгө шилжихгүй); production-д "mock" бол API асахгүй.
PAYMENT_PROVIDER=mock
# QPay merchant гэрээ байгуулсны дараа QPay-ээс өгнө. Sandbox: https://merchant-sandbox.qpay.mn/v2
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Төлбөр орсны дараа QPay дуудах манай хаяг — интернэтээс хүрэх ёстой (prod: https://<домэйн>/api/payments/qpay/callback)
QPAY_CALLBACK_URL=http://localhost:4000/payments/qpay/callback

# ----- Имэйл (нууц үг сэргээх, захиалгын холбоос) ---------------------
# Dev: Mailpit (pnpm infra:up) — илгээсэн имэйлийг http://localhost:8025 дээр харна.
# Prod: SMTP relay, ж: smtps://USER:PASSWORD@email-smtp.ap-northeast-1.amazonaws.com:465
SMTP_URL=smtp://localhost:1025
# docker compose --profile app үед контейнер доторх хаяг
SMTP_URL_DOCKER=smtp://mailpit:1025
# SPF/DKIM тохируулсан домэйнээс илгээнэ (үгүй бол spam-д орно)
MAIL_FROM=Pic <no-reply@pic.local>

# ----- Web ------------------------------------------------------------
# Next.js сервер API руу хандах хаяг. Browser нь /api/*-аар web-ээр дамжина (next.config.ts).
API_INTERNAL_URL=http://localhost:4000

# ----- Seed (зөвхөн dev) ----------------------------------------------
SEED_ADMIN_EMAIL=admin@pic.local
SEED_ADMIN_PASSWORD=change-me-admin-login
SEED_PHOTOGRAPHER_PASSWORD=change-me-photographer-login
